{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "workloads",
    "serviceAccounts",
    "cloudSqlProxy",
    "secretManager"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "releasePhase",
        "runtimeProviderReady",
        "releaseRevision",
        "appImage",
        "frontendImage"
      ],
      "properties": {
        "releasePhase": {
          "enum": [
            "migration",
            "application",
            "operations",
            "role-rotation"
          ]
        },
        "runtimeProviderReady": {
          "type": "boolean"
        },
        "releaseRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "appImage": {
          "$ref": "#/definitions/image"
        },
        "frontendImage": {
          "$ref": "#/definitions/image"
        },
        "deploymentProfile": {
          "enum": [
            "managed",
            "development",
            "private"
          ]
        }
      }
    },
    "cloudSqlProxy": {
      "type": "object",
      "required": [
        "enabled",
        "instanceConnectionName",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "instanceConnectionName": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "secretManager": {
      "type": "object",
      "required": [
        "enabled",
        "projectId",
        "runtimeSecrets",
        "migrationSecrets"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "runtimeSecrets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/secretFile"
          }
        },
        "migrationSecrets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/secretFile"
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "required": [
        "enabled",
        "subjectRoles",
        "operatorSecrets",
        "executorSecrets",
        "executorClaimCheckPrefix"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authProvider": {
          "enum": [
            "iap"
          ]
        },
        "subjectRoles": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "enum": [
              "viewer",
              "operator",
              "reviewer"
            ]
          }
        },
        "operatorSecrets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/secretFile"
          }
        },
        "executorSecrets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/secretFile"
          }
        },
        "executorClaimCheckPrefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9/_-]{1,200}$"
        }
      }
    },
    "privateRuntime": {
      "type": "object",
      "properties": {
        "postgresCASecretName": {
          "type": "string"
        },
        "redisCASecretName": {
          "type": "string"
        },
        "temporalCASecretName": {
          "type": "string"
        },
        "cadenceEnabled": {
          "type": "boolean"
        },
        "temporalClientSecretNames": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
          }
        },
        "processSecrets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/secretFile"
            }
          }
        },
        "controllerSecrets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/secretFile"
          }
        }
      }
    },
    "publicEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "bootstrap",
        "hostname",
        "staticIpName",
        "certificateMap",
        "proxyImage",
        "sslPolicy"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bootstrap": {
          "type": "boolean"
        },
        "hostname": {
          "enum": [
            "events.iliazlobin.com"
          ]
        },
        "staticIpName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z]([a-z0-9-]*[a-z0-9])?$"
        },
        "certificateMap": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z]([a-z0-9-]*[a-z0-9])?$"
        },
        "proxyImage": {
          "$ref": "#/definitions/image"
        },
        "sslPolicy": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z]([a-z0-9-]*[a-z0-9])?$"
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^@]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "secretFile": {
      "type": "object",
      "required": [
        "fileName",
        "secretName",
        "version"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    }
  }
}

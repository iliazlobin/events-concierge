{
  admin off
  auto_https off
  persist_config off
  log {
    level WARN
    exclude http.log.error
  }
}

# GFE reaches this filter; Next.js is reached over the same Pod's loopback.
http://:8080 {
  # Navigation only: never proxy admin requests through the consumer frontend.
  @admin_entry {
    host {{ .Values.publicEdge.hostname }}
    method GET HEAD
    expression `{http.request.orig_uri}.matches('^/admin/?([?].*)?$')`
  }
  handle @admin_entry {
    redir https://{{ .Values.operator.hostname }}/admin 302
  }
  @consumer {
    host {{ .Values.publicEdge.hostname }}
    path / /app /sign-in /settings /settings/* /_next/* /v1 /v1/* /auth /auth/* /terms /terms/* /privacy /privacy/* /favicon.ico
  }
  handle @consumer {
    request_header -X-Forwarded-*
    request_body {
      max_size 1MB
    }
    reverse_proxy 127.0.0.1:3000 {
      header_up -Forwarded
      header_up -X-Real-IP
      header_up -X-Goog-*
      header_up -Cf-Access-*
      header_up -X-Middleware-Subrequest
      header_up Host {{ .Values.publicEdge.hostname }}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {{ .Values.publicEdge.hostname }}
      transport http {
        dial_timeout 2s
        response_header_timeout 30s
      }
    }
  }
  handle {
    respond "" 404
  }
}

# GFE health checks and kubelet probes use a distinct port, never an HTTPRoute.
http://:8081 {
  handle /healthz {
    respond "ok" 200
  }
  handle /readyz {
    reverse_proxy 127.0.0.1:3000 {
      transport http {
        dial_timeout 2s
        response_header_timeout 5s
      }
    }
  }
  handle {
    respond "" 404
  }
}

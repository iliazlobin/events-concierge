{
  admin off
  auto_https off
  persist_config off
  log {
    level WARN
    exclude http.log.error
  }
}

# Separate GFE backends share Next.js over Pod loopback; port 3000 is never exposed.
http://:8080 {
  @consumer {
    host {{ .Values.publicEdge.hostname }}
    # Match the original URI, before decoding or normalization. Queries are retained.
    expression `{http.request.hostport}.matches('^events[.]iliazlobin[.]com(:443)?$') && {http.request.orig_uri}.matches('^(/|/app/?|/sign-in/?|/settings(/([-A-Za-z0-9_.~]|%[A-Fa-f0-9]{2})+)*/?|/_next/static(/([-A-Za-z0-9_.~]|%[A-Fa-f0-9]{2})+)+|/v1(/([-A-Za-z0-9_.~]|%[A-Fa-f0-9]{2})+)*/?|/auth(/([-A-Za-z0-9_.~]|%[A-Fa-f0-9]{2})+)*/?|/terms(/([-A-Za-z0-9_.~]|%[A-Fa-f0-9]{2})+)*/?|/privacy(/([-A-Za-z0-9_.~]|%[A-Fa-f0-9]{2})+)*/?|/favicon[.]ico)([?].*)?$') && !{http.request.orig_uri}.matches('^[^?]*(%(2[eEfF]|5[cC]|25)|/[.]{1,2}(/|[?]|$))')`
  }
  handle @consumer {
    request_header -X-Forwarded-*
    request_body {
      max_size 1MB
    }
    reverse_proxy 127.0.0.1:3000 {
      header_up -Forwarded
      header_up -X-Real-IP
      header_up -X-Goog-*
      header_up -Cf-Access-*
      header_up -X-Middleware-*
      header_up Host {{ .Values.publicEdge.hostname }}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {{ .Values.publicEdge.hostname }}
      transport http {
        dial_timeout 2s
        response_header_timeout 30s
      }
    }
  }
  handle {
    respond "" 404
  }
}

# Only the IAP-protected Service targets this port. Presence is not JWT verification:
# IAP authenticates page access; the operator API verifies signature/audience/owner.
http://:8082 {
  {{- if not .Values.publicEdge.bootstrap }}
  @admin {
    host {{ .Values.publicEdge.hostname }}
    expression `{http.request.hostport}.matches('^events[.]iliazlobin[.]com(:443)?$') && {http.request.orig_uri}.matches('^/admin(/([-A-Za-z0-9_.~]|%[A-Fa-f0-9]{2})+)*/?([?].*)?$') && !{http.request.orig_uri}.matches('^[^?]*(%(2[eEfF]|5[cC]|25)|/[.]{1,2}(/|[?]|$))')`
  }
  handle @admin {
    @assertion expression `{http.request.header.X-Goog-IAP-JWT-Assertion}.matches('^[A-Za-z0-9_-]+[.][A-Za-z0-9_-]+[.][A-Za-z0-9_-]+$') && size({http.request.header.X-Goog-IAP-JWT-Assertion}) <= 8192`
    handle @assertion {
      vars iap_assertion {http.request.header.X-Goog-IAP-JWT-Assertion}
      request_header -X-Goog-*
      request_header -X-Forwarded-*
      request_body {
        max_size 1MB
      }
      reverse_proxy 127.0.0.1:3000 {
        header_up -Forwarded
        header_up -X-Real-IP
        header_up -Cf-Access-*
        header_up -X-Middleware-*
        header_up X-Goog-IAP-JWT-Assertion {http.vars.iap_assertion}
        header_up Host {{ .Values.publicEdge.hostname }}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {{ .Values.publicEdge.hostname }}
        transport http {
          dial_timeout 2s
          response_header_timeout 30s
        }
      }
    }
    handle {
      respond "" 401
    }
  }
  {{- end }}
  handle {
    respond "" 404
  }
}

# GFE health checks and kubelet probes use a distinct port, never an HTTPRoute.
http://:8081 {
  handle /healthz {
    respond "ok" 200
  }
  handle /readyz {
    reverse_proxy 127.0.0.1:3000 {
      transport http {
        dial_timeout 2s
        response_header_timeout 5s
      }
    }
  }
  handle {
    respond "" 404
  }
}

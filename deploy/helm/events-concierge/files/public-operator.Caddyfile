# A separate loopback listener; consumer requests on :8080 retain their exclusions.
http://:8082 {
  bind 127.0.0.1
  @operator {
    host {{ .Values.operator.hostname }}
    path /admin /admin/* /_next/* /favicon.ico
    header Cf-Access-Jwt-Assertion *
  }
  handle @operator {
    # Save the assertion before removing all Access headers from the upstream request.
    vars operator_access_assertion {http.request.header.Cf-Access-Jwt-Assertion}
    request_header -Cf-Access-*
    request_header -X-Forwarded-*
    request_body {
      max_size 64KB
    }
    reverse_proxy {{ include "events-concierge.fullname" . }}-operator-frontend:80 {
      header_up -Forwarded
      header_up -X-Real-IP
      header_up -X-Goog-*
      header_up -Authorization
      header_up -Cookie
      header_up -X-Middleware-Subrequest
      # Forward only the assertion; the operator API verifies its signature and claims.
      header_up Cf-Access-Jwt-Assertion {http.vars.operator_access_assertion}
      header_up Host {{ .Values.operator.hostname }}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {{ .Values.operator.hostname }}
      transport http {
        dial_timeout 2s
        response_header_timeout 30s
      }
    }
  }
  handle {
    respond "" 404
  }
}

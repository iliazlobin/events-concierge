{
  "name": "events-concierge-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "test:account": "node --no-warnings --experimental-strip-types --test tests/account-*.test.mjs",
    "test:admin": "node --no-warnings --experimental-strip-types --test tests/admin-*.test.mjs",
    "test:entity-graph": "node --no-warnings --experimental-strip-types --test tests/entity-graph*.test.mjs",
    "test:events": "node --no-warnings --experimental-strip-types --test tests/event-*.test.mjs",
    "test:filters": "node --no-warnings --experimental-strip-types --test tests/filter-suggestions.test.mjs",
    "test:intent": "node --no-warnings --experimental-strip-types --test tests/chat-intent.test.mjs",
    "test:proxy": "node --no-warnings --experimental-strip-types --test tests/runtime-api-proxy.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "maplibre-gl": "6.4.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}

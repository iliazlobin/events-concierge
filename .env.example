# Copy to .env for local development. Cloud defaults remain mocked; no real credential is required.
# Never commit a populated .env. Production secrets should come from the deployment platform's
# secret manager, not from this file.

# --- Host bind ports (Compose publishes loopback-only by default) ---
# Keep this on loopback while EC_ADMIN_INGESTION_ENABLED=true; startup rejects wider binds.
EC_API_BIND_ADDRESS=127.0.0.1
EC_API_PORT=8000
EC_POSTGRES_BIND_ADDRESS=127.0.0.1
EC_POSTGRES_PORT=5433
EC_REDIS_BIND_ADDRESS=127.0.0.1
EC_REDIS_PORT=6380
EC_TEMPORAL_BIND_ADDRESS=127.0.0.1
EC_TEMPORAL_PORT=7234
EC_TEMPORAL_UI_BIND_ADDRESS=127.0.0.1
EC_TEMPORAL_UI_PORT=8234
# Local image name used by the Compose `app` profile.
EC_IMAGE=events-concierge:local

# --- Local dependency services (docker-compose) ---
# These localhost URLs are for processes launched directly on the host. Compose overrides them
# with service-DNS URLs inside app containers; EC_CONTAINER_* is available for advanced overrides.
EC_DATABASE_URL=postgresql+psycopg://ec_app:ec_app@localhost:5433/ec
EC_MIGRATION_URL=postgresql+psycopg://ec:ec@localhost:5433/ec  # owner role for migrations only
EC_REDIS_URL=redis://localhost:6380/0
EC_TEMPORAL_TARGET=localhost:7234
EC_TEMPORAL_NAMESPACE=default
EC_TEMPORAL_TASK_QUEUE=events-concierge
EC_TEMPORAL_TLS_ENABLED=false
# EC_TEMPORAL_TLS_DOMAIN=your-account.tmprl.cloud
# EC_TEMPORAL_API_KEY=replace-with-secret-manager-reference
# Per-call bound for connects, starts, signals, and description reads (0.1-60 seconds).
EC_TEMPORAL_RPC_TIMEOUT_SECONDS=5
# Bound one worker to the local CPU/database budget; tune the pair together in deployment.
EC_TEMPORAL_WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=8
EC_TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITIES=8
# Total decoded API body-read deadline; protects workers from slow/dripping callers.
EC_REQUEST_BODY_TIMEOUT_SECONDS=10
# A tenant external effect retains its PostgreSQL erasure authority until the provider call settles.
# Provider transport deadlines must be no greater than this bounded drain deadline.
EC_TENANT_EFFECT_TIMEOUT_SECONDS=30
# Bound acquisition of the per-tenant advisory lock shared with account-erasure fencing.
EC_TENANT_EFFECT_LOCK_TIMEOUT_SECONDS=5
EC_CLAIM_CHECK_THRESHOLD_BYTES=262144
EC_CLAIM_CHECK_LOCAL_ROOT=/tmp/events-concierge-claim-check
# Profile avatars have their own persistent lifetime, independent of claim-check payloads.
EC_MEDIA_BACKEND=local
EC_MEDIA_LOCAL_ROOT=/tmp/events-concierge-media

# --- App ---
EC_ENV=local
EC_LOG_LEVEL=info
# User-facing handoff capability origin. Non-mock composition requires HTTPS.
EC_PUBLIC_BASE_URL=http://localhost:8000
# Deployment/BFF login entrypoint used by the consumer shell; relative same-origin is preferred.
# EC_UI_AUTH_START_URL=/auth/login

# --- Discovery (owner-reviewed anonymous public sources; refresh is explicit) ---
EC_DISCOVERY_SOURCES=public_jsonld       # comma-separated enabled SourcePort adapters
EC_CRAWL_USER_AGENT=events-concierge-bot/0.1 (+https://example.com/bot)
EC_CRAWL_MAX_CONCURRENCY=4
EC_CRAWL_MIN_INTERVAL_MS=1500            # human-cadence pacing floor per host
# Opt-in only. Comma-separated, owner-approved public JSON-LD calendars/pages; discovery stays handoff-only.
# EC_CRAWL_SEED_URLS=https://luma.com/genai-sf
# A manual `make catalog-cadence` pass evaluates at most this many due reviewed sources. It does not
# enable a policy or create a recurring live-crawl schedule.
EC_CATALOG_REFRESH_LEASE_SECONDS=300
EC_CATALOG_REFRESH_DISPATCH_BATCH_SIZE=50
# Local-only ingestion control room. Production settings reject this until a distinct operator
# identity/session and database role are implemented.
EC_ADMIN_INGESTION_ENABLED=false
# Outside the Compose app profile this recurring enqueue-only scheduler is opt-in. It checks for at
# least one reviewed due source, then relies on the durable command worker for guarded execution.
EC_CATALOG_INGESTION_SCHEDULER_ENABLED=false
EC_CATALOG_INGESTION_SCHEDULER_INTERVAL_SECONDS=300
EC_CATALOG_INGESTION_COMMAND_BATCH_SIZE=2
EC_CATALOG_INGESTION_COMMAND_POLL_SECONDS=2
EC_CATALOG_INGESTION_COMMAND_LEASE_SECONDS=300

# --- ADR-005 Pacer ---
# ``auto`` preserves Redis in non-mock deployments. Set redis explicitly to exercise shared,
# throttle-first state with mock cloud adapters; set memory only for fast fixture-only runs.
EC_PACER_BACKEND=auto
EC_PACER_RATE_PER_SECOND=5
EC_PACER_BURST=10
EC_PACER_UNAVAILABLE_RETRY_SECONDS=2
# How long a shared bucket's tokens/timestamp survive idleness. A missing bucket is treated as
# lost state and fails throttle-first, so this must exceed the gap between two ordinary uses of
# one bucket. Reviewed sources refresh on cadences up to a day, so this must outlast the
# slowest of them or every refresh is deferred before any provider call.
EC_PACER_STATE_RETENTION_SECONDS=604800
# Keep Meetup paced per user token until the owner runs G2.  Per-app scope is a shared Redis
# fair-share contingency: it refuses to start without explicit G2 evidence and creates no live
# Meetup integration or SLA claim by itself.
EC_MEETUP_QUOTA_SCOPE_MODE=per_token
EC_MEETUP_APP_QUOTA_SCOPE=meetup-app
EC_MEETUP_APP_G2_VALIDATED=false
EC_MEETUP_APP_DEGRADE_AFTER_SECONDS=300
# Browser calls use a separate, held global admission lease rather than a source-rate token.
# Redis loss establishes a five-minute recovery fence; do not raise capacity beyond the ratified
# 90%-of-vendor-contract limit when a real FleetPort is later enabled (AC-45, NFR-4b).
EC_BROWSER_POOL_CAPACITY=135
EC_BROWSER_ADMISSION_LEASE_SECONDS=300
# Opaque app-scope label only; do not put a Ticketmaster API key in this value. Changing it also
# requires an owner-run update to provider_budget_scope; a mismatch fails closed.
EC_TICKETMASTER_QUOTA_SCOPE=ticketmaster-app

# --- Runtime provider graph ---
# The local graph uses non-production in-memory/file-backed adapters. A non-mock deployment fails
# closed unless a deployment-owned factory returns every required RuntimePorts implementation. It
# must include one coherent AuthContextPort/CsrfProtectionPort pair unless the built-in OIDC BFF
# below supplies both from its Redis-backed session. The CSRF verifier runs after authentication and
# provisioning for preferences, durable intake, feedback, withdrawal, and authenticated task
# completion. It rejects missing/mismatched/cross-origin session evidence; signed
# /v1/tasks/{token}/done capabilities remain a separate explicit-POST authority boundary.
# Production also requires a KMS/envelope-backed NotificationSecretProtector.
EC_MOCK_CLOUD=true
# EC_RUNTIME_PROVIDER_FACTORY=your_deployment.runtime:build_runtime_ports

# The repository-owned production browser identity option is an OIDC authorization-code BFF.
# It requires mock cloud off plus the remaining RuntimePorts (object storage, notifier, vault,
# calendar and explicit source maps) from the factory above. Access/identity tokens stay server
# side. Redis stores only TTL-bounded login/session JSON under SHA-256-digested opaque handles;
# the browser receives Secure, Path=/, no-Domain __Host- cookies. Login uses state + nonce + S256
# PKCE, and POST/PUT mutations require both the __Host-ec_csrf cookie/X-EC-CSRF header pair and an
# Origin exactly matching EC_PUBLIC_BASE_URL. EC_PUBLIC_BASE_URL must therefore be the public HTTPS
# origin only (no path/query) and the IdP callback must be registered as /auth/callback.
EC_OIDC_BFF_ENABLED=false
# EC_OIDC_ISSUER=https://identity.example.com/
# EC_OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
# EC_OIDC_TOKEN_URL=https://identity.example.com/oauth/token
# EC_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# EC_OIDC_CLIENT_ID=events-concierge-web
# EC_OIDC_CLIENT_SECRET=replace-with-secret-manager-value
# EC_OIDC_TENANT_CLAIM=https://events.example.com/tenant_id
EC_OIDC_ALGORITHMS=RS256
EC_OIDC_LOGIN_TTL_SECONDS=600
EC_OIDC_SESSION_TTL_SECONDS=28800
EC_ACCOUNT_ERASURE_RECENT_AUTH_SECONDS=300
EC_OIDC_HTTP_TIMEOUT_SECONDS=5
EC_OIDC_SESSION_STORE_TIMEOUT_SECONDS=2

# --- Explicit provider-adapter selection (both disabled by default) ---
# Setting a non-empty Cohere key switches only the cross-encoder; the deterministic embedding stays
# available for offline candidate vectors. Do not commit a real key.
# EC_COHERE_API_KEY=replace-with-provisioned-secret
EC_COHERE_RERANK_MODEL=rerank-v3.5
EC_COHERE_TIMEOUT_SECONDS=10
# Google Calendar selection never accepts a global bearer token. It additionally requires a
# deployment-provided tenant-scoped GoogleCalendarAccessPort and uses RLS calendar bindings.
# The optional plugin must be a trusted local module callable returning that port; it owns OAuth
# refresh/token lifecycle and is not part of this repository.
EC_GOOGLE_CALENDAR_ENABLED=false
# EC_GOOGLE_CALENDAR_ACCESS_FACTORY=your_deployment.google_access:build_access_port
EC_GOOGLE_CALENDAR_TIMEOUT_SECONDS=10

# --- Policy defaults (owner-accepted, design/owner-decisions.md) ---
EC_ATTEMPT_BUDGET=3
EC_HANDOFF_TTL_DAYS=7
EC_KILL_SWITCH=false

# --- Durable workers ---
EC_OUTBOX_BATCH_SIZE=50
EC_OUTBOX_POLL_SECONDS=2
EC_OUTBOX_LEASE_SECONDS=60
# Durable request-start recovery is deliberately paced even while a backlog is non-empty.
EC_REQUEST_START_BATCH_SIZE=5
EC_REQUEST_START_POLL_SECONDS=2
EC_REQUEST_START_LEASE_SECONDS=60
EC_CHANGE_DELIVERY_BATCH_SIZE=50
EC_CHANGE_DELIVERY_POLL_SECONDS=2
EC_CHANGE_DELIVERY_LEASE_SECONDS=60
EC_HANDOFF_EXPIRY_BATCH_SIZE=50
EC_HANDOFF_EXPIRY_POLL_SECONDS=900
EC_HANDOFF_EXPIRY_LEASE_SECONDS=60
EC_LIFECYCLE_INVARIANT_BATCH_SIZE=500
# Per-process Temporal describe cadence (validated 1-20 calls/second; default is conservative).
EC_LIFECYCLE_INVARIANT_LIVENESS_CALLS_PER_SECOND=10
EC_LIFECYCLE_INVARIANT_POLL_SECONDS=86400

# Explicit local fixture logins created by make migrate. They never grant authority to ec_app.
EC_OPERATOR_DATABASE_URL=postgresql+psycopg://ec_local_operator:ec_local_operator@localhost:5433/ec
EC_INGESTION_EXECUTOR_DATABASE_URL=postgresql+psycopg://ec_local_ingestion:ec_local_ingestion@localhost:5433/ec
EC_INGESTION_EXECUTOR_ENABLED=false
# Hosted management is a separate IAP-protected entrypoint. Never enable the local admin flag there.
EC_OPERATOR_API_ENABLED=false

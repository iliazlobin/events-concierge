# Copy to .env for local development. Cloud defaults remain mocked; no real credential is required.
# Explicit Cohere/Google adapter selection below is transport wiring only. OAuth/access-token
# provisioning remains owner-gated (see design/owner-decisions.md Part C).

# --- Local dependency services (docker-compose) ---
EC_DATABASE_URL=postgresql+psycopg://ec_app:ec_app@localhost:5433/ec
EC_MIGRATION_URL=postgresql+psycopg://ec:ec@localhost:5433/ec  # owner role for migrations only
EC_REDIS_URL=redis://localhost:6380/0
EC_TEMPORAL_TARGET=localhost:7234
EC_TEMPORAL_NAMESPACE=default
EC_TEMPORAL_TASK_QUEUE=events-concierge

# --- App ---
EC_ENV=local
EC_LOG_LEVEL=info

# --- Discovery (free-crawl first; API connectors are a future adapter swap) ---
EC_DISCOVERY_SOURCES=public_jsonld       # comma-separated enabled SourcePort adapters
EC_CRAWL_USER_AGENT=events-concierge-bot/0.1 (+https://example.com/bot)
EC_CRAWL_MAX_CONCURRENCY=4
EC_CRAWL_MIN_INTERVAL_MS=1500            # human-cadence pacing floor per host
# Opt-in only. Comma-separated, owner-approved public JSON-LD calendars/pages; discovery stays handoff-only.
# EC_CRAWL_SEED_URLS=https://luma.com/genai-sf
# A manual `make catalog-cadence` pass evaluates at most this many due reviewed sources. It does not
# enable a policy or create a recurring live-crawl schedule.
EC_CATALOG_REFRESH_DISPATCH_BATCH_SIZE=50

# --- ADR-005 Pacer ---
# ``auto`` preserves Redis in non-mock deployments. Set redis explicitly to exercise shared,
# throttle-first state with mock cloud adapters; set memory only for fast fixture-only runs.
EC_PACER_BACKEND=auto
EC_PACER_RATE_PER_SECOND=5
EC_PACER_BURST=10
EC_PACER_UNAVAILABLE_RETRY_SECONDS=2
# Keep Meetup paced per user token until the owner runs G2.  Per-app scope is a shared Redis
# fair-share contingency: it refuses to start without explicit G2 evidence and creates no live
# Meetup integration or SLA claim by itself.
EC_MEETUP_QUOTA_SCOPE_MODE=per_token
EC_MEETUP_APP_QUOTA_SCOPE=meetup-app
EC_MEETUP_APP_G2_VALIDATED=false
EC_MEETUP_APP_DEGRADE_AFTER_SECONDS=300
# Browser calls use a separate, held global admission lease rather than a source-rate token.
# Redis loss establishes a five-minute recovery fence; do not raise capacity beyond the ratified
# 90%-of-vendor-contract limit when a real FleetPort is later enabled (AC-45, NFR-4b).
EC_BROWSER_POOL_CAPACITY=135
EC_BROWSER_ADMISSION_LEASE_SECONDS=300
# Opaque app-scope label only; do not put a Ticketmaster API key in this value. Changing it also
# requires an owner-run update to provider_budget_scope; a mismatch fails closed.
EC_TICKETMASTER_QUOTA_SCOPE=ticketmaster-app

# --- Mocked cloud services (no real creds needed in the foundation) ---
EC_MOCK_CLOUD=true                       # KMS/SES/S3/Calendar/Anthropic/Browserbase served by in-memory fakes

# --- Explicit provider-adapter selection (both disabled by default) ---
# Setting a non-empty Cohere key switches only the cross-encoder; the deterministic embedding stays
# available for offline candidate vectors. Do not commit a real key.
# EC_COHERE_API_KEY=replace-with-provisioned-secret
EC_COHERE_RERANK_MODEL=rerank-v3.5
EC_COHERE_TIMEOUT_SECONDS=10
# Google Calendar selection never accepts a global bearer token. It additionally requires a
# deployment-provided tenant-scoped GoogleCalendarAccessPort and uses RLS calendar bindings.
# The optional plugin must be a trusted local module callable returning that port; it owns OAuth
# refresh/token lifecycle and is not part of this repository.
EC_GOOGLE_CALENDAR_ENABLED=false
# EC_GOOGLE_CALENDAR_ACCESS_FACTORY=your_deployment.google_access:build_access_port
EC_GOOGLE_CALENDAR_TIMEOUT_SECONDS=10

# --- Policy defaults (owner-accepted, design/owner-decisions.md) ---
EC_ATTEMPT_BUDGET=3
EC_HANDOFF_TTL_DAYS=7
EC_KILL_SWITCH=false

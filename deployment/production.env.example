# Structural production-config contract. This file contains no usable credential and is never
# loaded by the local Compose stack. A deployment injects real values from its secret/config
# manager, runs the full validator (without --structural-only), and retains the sanitized evidence.
EC_ENV=staging
EC_LOG_LEVEL=info
EC_PUBLIC_BASE_URL=https://staging.concierge.example
EC_UI_AUTH_START_URL=/auth/login

# Application role only. Migration jobs receive a separate owner URL; application containers must
# not receive EC_MIGRATION_URL.
EC_DATABASE_URL=postgresql+psycopg://ec_app:secret-manager-reference@postgres.internal.example/events?sslmode=verify-full
EC_DATABASE_CONNECTION_MODE=direct_tls
EC_DATABASE_POOL_SIZE=8
EC_DATABASE_MAX_OVERFLOW=0
EC_REDIS_URL=rediss://:secret-manager-reference@redis.internal.example:6380/0?ssl_cert_reqs=required&ssl_check_hostname=true
EC_PACER_BACKEND=redis

EC_TEMPORAL_TARGET=namespace.tmprl.cloud:7233
EC_TEMPORAL_NAMESPACE=events-staging
EC_TEMPORAL_TASK_QUEUE=events-concierge-catalog
EC_TEMPORAL_TRANSACTIONAL_TASK_QUEUE=events-concierge-transactional
EC_TEMPORAL_CATALOG_TASK_QUEUE=events-concierge-catalog
EC_TEMPORAL_WORKER_DEPLOYMENT_NAME=events-concierge
EC_TEMPORAL_WORKER_VERSIONING_ENABLED=true
EC_TEMPORAL_TLS_ENABLED=true
EC_TEMPORAL_TLS_DOMAIN=namespace.tmprl.cloud
EC_TEMPORAL_API_KEY=secret-manager-reference

# Claim-check payloads are encrypted by GCS at rest and tenant-scoped by the application adapter.
EC_GCP_PROJECT=events-staging
EC_GCS_CLAIM_CHECK_BUCKET=events-staging-claim-check
EC_GCS_CLAIM_CHECK_PREFIX=events-concierge/claim-check/v1
# Separate private media bucket: no versioning, soft delete, lifecycle expiry or retention.
EC_MEDIA_BACKEND=gcs
EC_GCS_MEDIA_BUCKET=events-staging-media
EC_GCS_MEDIA_PREFIX=events-concierge/media/v1

# Provider transports must time out no later than the effect drain. The lock bound limits waiting
# to serialize a live external mutation with the durable account-erasure fence.
EC_TENANT_EFFECT_TIMEOUT_SECONDS=30
EC_TENANT_EFFECT_LOCK_TIMEOUT_SECONDS=5

EC_MOCK_CLOUD=false
EC_RUNTIME_PROVIDER_FACTORY=events_concierge.deployment.gcp_runtime:build_runtime_ports
# The repository admin control room is local-only until a separate production operator identity
# and control-plane role exist.
EC_ADMIN_INGESTION_ENABLED=false

# Repository-owned authorization-code OIDC BFF. Tokens stay server-side; browser handles and
# double-submit CSRF evidence are opaque and shared through the TLS Redis control plane.
EC_OIDC_BFF_ENABLED=true
EC_OIDC_ISSUER=https://identity.example.com/
EC_OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
EC_OIDC_TOKEN_URL=https://identity.example.com/oauth/token
EC_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
EC_OIDC_CLIENT_ID=events-concierge-staging
EC_OIDC_CLIENT_SECRET=secret-manager-reference
EC_OIDC_TENANT_CLAIM=https://concierge.example/tenant_id
EC_OIDC_ALGORITHMS=RS256
EC_ACCOUNT_ERASURE_RECENT_AUTH_SECONDS=300

# Immutable identity injected by the release controller. The digest is deliberately synthetic.
EC_RELEASE_REVISION=0123456789abcdef0123456789abcdef01234567
EC_IMAGE_DIGEST=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
